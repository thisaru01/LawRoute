<h2 style="color: #111827; margin-top: 0; font-size: 20px;">Issue Update Confirmed</h2>
<p style="color: #4b5563;">Your civil issue has been updated successfully. Here are the current details:</p>

<table class="responsive-table" style="width: 100%; border-collapse: collapse; margin: 24px 0;">
  <tr class="responsive-row">
    <td class="responsive-td responsive-label" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280; font-weight: 500; width: 35%;">Category</td>
    <td class="responsive-td responsive-value" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #111827; font-weight: 600;">{{formatText category}}</td>
  </tr>
  <tr class="responsive-row">
    <td class="responsive-td responsive-label" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280; font-weight: 500;">District</td>
    <td class="responsive-td responsive-value" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #111827; font-weight: 600;">{{formatText district}}</td>
  </tr>
  {{#if exactLocation}}
  <tr class="responsive-row">
    <td class="responsive-td responsive-label" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280; font-weight: 500;">Exact Location</td>
    <td class="responsive-td responsive-value" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #111827;">{{exactLocation}}</td>
  </tr>
  {{/if}}
  {{#if postalAreaOrZip}}
  <tr class="responsive-row">
    <td class="responsive-td responsive-label" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280; font-weight: 500;">Postal Area / Zip</td>
    <td class="responsive-td responsive-value" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #111827;">{{postalAreaOrZip}}</td>
  </tr>
  {{/if}}
  {{#if whatHappened}}
  <tr class="responsive-row">
    <td class="responsive-td responsive-label" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280; font-weight: 500;">What Happened</td>
    <td class="responsive-td responsive-value" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #111827;">{{whatHappened}}</td>
  </tr>
  {{/if}}
  {{#if whenItHappened}}
  <tr class="responsive-row">
    <td class="responsive-td responsive-label" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280; font-weight: 500;">When It Happened</td>
    <td class="responsive-td responsive-value" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #111827;">{{whenItHappened}}</td>
  </tr>
  {{/if}}
  {{#if impactOnPeople}}
  <tr class="responsive-row">
    <td class="responsive-td responsive-label" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280; font-weight: 500;">Impact on People</td>
    <td class="responsive-td responsive-value" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #111827;">{{impactOnPeople}}</td>
  </tr>
  {{/if}}
  {{#if contactNumber}}
  <tr class="responsive-row">
    <td class="responsive-td responsive-label" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280; font-weight: 500;">Contact Number</td>
    <td class="responsive-td responsive-value" style="padding: 12px 8px; border-bottom: 1px solid #e5e7eb; color: #111827;">{{contactNumber}}</td>
  </tr>
  {{/if}}
</table>

<div style="background-color: #fef2f2; border-left: 4px solid #ef4444; padding: 12px 16px; margin-top: 24px;">
  <p style="color: #991b1b; font-size: 13px; margin: 0;">
    <strong>Security Notice:</strong> If you did not make this change, please contact support immediately.
  </p>
</div>
